{
  "name": "gamil-minage-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Gamil Minage — API (Next.js route handlers + Neon + Cloudinary)",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
