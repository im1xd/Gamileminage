# ---- Frontend (Vercel project #2, Root Directory = frontend) ----
# Private URL of the backend project (server-side only — never shown to visitors).
BACKEND_URL=https://your-backend.vercel.app
# Must be IDENTICAL to PROXY_SECRET / REVALIDATE_SECRET in the backend project.
PROXY_SECRET=
REVALIDATE_SECRET=

# Public values (safe to expose).
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
